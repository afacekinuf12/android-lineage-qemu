diff --git a/device-common.mk b/device-common.mk
index b80b7ad..76efd69 100644
--- a/device-common.mk
+++ b/device-common.mk
@@ -20,8 +20,14 @@ TARGET_MINIGBM_PLATFORM := generic
 TARGET_GRAPHICS_COMPOSER_HAL := drm_hwcomposer
 
 # Init
+# init expands "import /vendor/etc/init/hw/init.${ro.hardware}.rc". The Pixel 9
+# Pro identity override sets ro.hardware=caiman (patch 0009), so a caiman HAL rc
+# must exist with the exact early-fs partition symlinks and mount_all the virtio
+# rc provides. Install the identical file under the caiman name so the boot
+# stages behave the same and the VM does not bootloop.
 PRODUCT_COPY_FILES += \
-    $(COMMON_PATH)/configs/init/init.virtio.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.virtio.rc
+    $(COMMON_PATH)/configs/init/init.virtio.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.virtio.rc \
+    $(COMMON_PATH)/configs/init/init.virtio.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.caiman.rc
 
 PRODUCT_PACKAGES += \
     fstab.virtio \
