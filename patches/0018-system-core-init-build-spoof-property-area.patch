+#pragma once
+
+namespace android {
+namespace init {
+
+// Build a complete spoofed copy of the system property area at
+// /dev/__properties_spoof__ from /dev/__properties__, applying the overrides in
+// /system/etc/spoof_props.txt. Best-effort and non-fatal: any failure logs and
+// returns without affecting the real property area or boot. Call once from
+// PropertyInit(), after PropertyLoadBootDefaults().
+void BuildSpoofedPropertyArea();
+
+}  // namespace init
+}  // namespace android
