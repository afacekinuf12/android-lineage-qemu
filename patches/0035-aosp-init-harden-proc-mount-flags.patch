From: Android VirtIO maintainers
Subject: [PATCH] init: restrict procfs to non-executable metadata

Mount procfs with nodev, nosuid and noexec while retaining hidepid and the
readproc group. No process, file content, identity or mount entry is hidden.
The same flags apply to normal and recovery first-stage init.

diff --git a/init/first_stage_init.cpp b/init/first_stage_init.cpp
--- a/init/first_stage_init.cpp
+++ b/init/first_stage_init.cpp
@@ -354,7 +354,8 @@
     CHECKCALL(mkdir("/dev/dm-user", 0755));
     CHECKCALL(mount("devpts", "/dev/pts", "devpts", 0, NULL));
 #define MAKE_STR(x) __STRING(x)
-    CHECKCALL(mount("proc", "/proc", "proc", 0, "hidepid=2,gid=" MAKE_STR(AID_READPROC)));
+    CHECKCALL(mount("proc", "/proc", "proc", MS_NODEV | MS_NOSUID | MS_NOEXEC,
+                    "hidepid=2,gid=" MAKE_STR(AID_READPROC)));
 #undef MAKE_STR
     std::string cmdline;
     android::base::ReadFileToString("/proc/cmdline", &cmdline);
