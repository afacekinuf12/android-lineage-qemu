diff --git a/configs/prop/prop_overrides.conf b/configs/prop/prop_overrides.conf
new file mode 100644
index 0000000..db3c54b
--- /dev/null
+++ b/configs/prop/prop_overrides.conf
@@ -0,0 +1,13 @@
+# Data-driven property override table for prop_service (resetprop-style).
+# Each line is "key=value". Blank lines and lines starting with '#' are ignored.
+# Applied at post-fs-data, after the real VirtIO HALs are resolved, so read-only
+# hardware identifiers can safely diverge from the truthful boot values.
+#
+# Pixel 9 Pro (caiman / Tensor G4 "zumapro") runtime identity. These are the
+# read-only values that build.prop and vendor_init cannot safely set because
+# they are consumed for HAL path resolution during early boot.
+ro.hardware=caiman
+ro.boot.hardware=caiman
+ro.boot.hardware.sku=caiman
+ro.boot.product.hardware.sku=caiman
+ro.hardware.chipname=zumapro
