index 9feb0a9..e213ace 100644
--- a/libraries/libinit/libinit_virt.cpp
+++ b/libraries/libinit/libinit_virt.cpp
@@ -32,6 +32,28 @@ static void set_misc_properties() {
     }
 }
 
+// Align the platform/board identity strings with a Google Pixel 9 Pro (the
+// Tensor G4 "zumapro" platform). These are pure identity strings and are never
+// used by init to resolve a HAL rc import path, so overriding them in
+// vendor_init is safe.
+//
+// Do NOT override ro.hardware / ro.boot.hardware here. vendor_load_properties()
+// runs from PropertyInit() -> PropertyLoadBootDefaults(), which SecondStageMain
+// calls BEFORE LoadBootScripts(). LoadBootScripts() then expands
+// "import /vendor/etc/init/hw/init.${ro.hardware}.rc"; rewriting ro.hardware to
+// "caiman" here makes init import the wrong hardware service graph and the
+// device bootloops, even if an init.caiman.rc copy is installed. Keep the real
+// VirtIO hardware selector for init/HAL resolution; identity-only properties
+// below do not participate in service selection.
+static void set_pixel_platform_identity() {
+    property_override("ro.board.platform", "zumapro");
+    property_override("ro.product.board", "zumapro");
+    property_override("ro.product.vendor.board", "caiman");
+    property_override("ro.hardware.chipname", "zumapro");
+    property_override("ro.soc.manufacturer", "Google");
+    property_override("ro.soc.model", "zumapro");
+}
+
 void vendor_process_bootenv_virt() {
     vendor_process_bootenv_mainline_common();
 }
@@ -40,4 +62,5 @@ void vendor_load_properties_virt() {
     vendor_load_properties_mainline_common();
     set_misc_properties();
     set_properties_from_dmi_id();
+    set_pixel_platform_identity();
 }
