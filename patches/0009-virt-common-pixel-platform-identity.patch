diff --git a/libraries/libinit/libinit_virt.cpp b/libraries/libinit/libinit_virt.cpp
index 9feb0a9..e213ace 100644
--- a/libraries/libinit/libinit_virt.cpp
+++ b/libraries/libinit/libinit_virt.cpp
@@ -32,6 +32,26 @@ static void set_misc_properties() {
     }
 }
 
+// Align the platform/board identity strings with a Google Pixel 9 Pro (caiman
+// on the Tensor G4 "zumapro" platform). These are consumed only as identity
+// strings, never for HAL module path resolution, so overriding them here in
+// vendor_init is safe. LoadBootScripts() (which resolves the
+// init.${ro.hardware}.rc HAL import) runs in SecondStageMain BEFORE
+// vendor_load_properties(), so overriding ro.hardware here does not break HAL
+// loading and does not bootloop.
+static void set_pixel_platform_identity() {
+    property_override("ro.board.platform", "zumapro");
+    property_override("ro.product.board", "zumapro");
+    property_override("ro.product.vendor.board", "caiman");
+    property_override("ro.hardware.chipname", "zumapro");
+    property_override("ro.soc.manufacturer", "Google");
+    property_override("ro.soc.model", "zumapro");
+    property_override("ro.hardware", "caiman");
+    property_override("ro.boot.hardware", "caiman");
+    property_override("ro.boot.hardware.sku", "caiman");
+    property_override("ro.boot.product.hardware.sku", "caiman");
+}
+
 void vendor_process_bootenv_virt() {
     vendor_process_bootenv_mainline_common();
 }
@@ -40,4 +60,5 @@ void vendor_load_properties_virt() {
     vendor_load_properties_mainline_common();
     set_misc_properties();
     set_properties_from_dmi_id();
+    set_pixel_platform_identity();
 }
