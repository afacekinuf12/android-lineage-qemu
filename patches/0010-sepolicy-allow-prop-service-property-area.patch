+# Only the init property service should write to /data/property and /dev/__properties__.
+# prop_service (device/virt) is a deliberate local exception performing
+# resetprop-style read-only rewrites after HAL resolution; research VMs only.
+neverallow { domain -init -prop_service } property_data_file:dir no_w_dir_perms;
+neverallow { domain -init -prop_service } property_data_file:file { no_w_file_perms no_x_file_perms };
+neverallow { domain -init -prop_service } property_type:file { no_w_file_perms no_x_file_perms };
+neverallow { domain -init -prop_service } properties_device:file { no_w_file_perms no_x_file_perms };
+neverallow { domain -init -prop_service } properties_serial:file { no_w_file_perms no_x_file_perms };
 
