diff --git a/private/prop_service.te b/private/prop_service.te
new file mode 100644
index 0000000..fd10182
--- /dev/null
+++ b/private/prop_service.te
@@ -0,0 +1,17 @@
+type prop_service, domain, coredomain;
+type prop_service_exec, exec_type, file_type, system_file_type;
+
+init_daemon_domain(prop_service)
+
+# prop_service performs resetprop-style read-only property rewrites after HAL
+# resolution (post-fs-data). Writing the property-area device node is reserved
+# for init by the neverallows in domain.te; those are excepted for this single
+# domain so the permissions below compile. Every other domain stays fully
+# constrained. Only the property-area backing files are granted -- NOT the
+# broad property_type attribute, which would collide with per-property
+# neverallows.
+allow prop_service properties_device:file create_file_perms;
+allow prop_service properties_serial:file { write relabelto };
+
+# Read the override table shipped in /system_ext/etc (labeled system_file).
+allow prop_service system_file:file r_file_perms;
