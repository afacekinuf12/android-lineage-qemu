diff --git a/services/spoofprop_gen/spoofprop_gen.cpp b/services/spoofprop_gen/spoofprop_gen.cpp
new file mode 100644
index 0000000..a3bfdd3
--- /dev/null
+++ b/services/spoofprop_gen/spoofprop_gen.cpp
@@ -0,0 +1,111 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * spoofprop_gen (Stage 1) - emit the spoofed identity DATA that Stage 2 will
+ * expose only to target-app mount namespaces. This stage performs NO mounts,
+ * NO property-area reads, and NO property-area writes, so it needs no
+ * privileged SELinux permissions and cannot affect any running process:
+ *
+ *   1. Read the override list from /system/etc/spoof_props.txt and write it as
+ *      a flat "name<TAB>value" table to /dev/spoofprop/props.list. Stage 2
+ *      applies exactly these keys (all in the readable build_prop /
+ *      build_vendor_prop / bootloader_prop classes) into a target app's view.
+ *   2. Render spoofed copies of the build.prop files (same overrides applied
+ *      line-by-line) under /dev/spoofprop/ for the file-open (svc/native) path.
+ *
+ * The generator never walks the live property area (which would require reading
+ * restricted property types that SELinux neverallows). It only rewrites the
+ * handful of build.prop-class keys we care about.
+ *
+ * Fabricates observable identity strings only; does not touch AVB/attestation.
+ */
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+#define LOG(...) do { fprintf(stderr, "spoofprop_gen: " __VA_ARGS__); fprintf(stderr, "\n"); } while (0)
+
+static const char* kPropsFile = "/system/etc/spoof_props.txt";
+static const char* kOutDir    = "/dev/spoofprop";
+
+// Ordered list preserves file order; map is only for build.prop line rewriting.
+struct Override { std::string key, val; };
+
+static std::vector<Override> load_overrides() {
+  std::vector<Override> v;
+  FILE* f = fopen(kPropsFile, "re");
+  if (!f) { LOG("no %s: %s", kPropsFile, strerror(errno)); return v; }
+  char* line = nullptr; size_t cap = 0; ssize_t n;
+  while ((n = getline(&line, &cap, f)) != -1) {
+    if (n && line[n-1] == '\n') line[--n] = 0;
+    if (n == 0 || line[0] == '#') continue;
+    char* eq = strchr(line, '=');
+    if (!eq) continue;
+    *eq = 0;
+    v.push_back({line, eq + 1});
+  }
+  free(line); fclose(f);
+  return v;
+}
+
+static void render_build_props(const std::vector<Override>& ov) {
+  std::map<std::string, std::string> m;
+  for (const auto& o : ov) m[o.key] = o.val;
+  const char* srcs[] = {"/system/build.prop", "/vendor/build.prop", "/product/etc/build.prop",
+                        "/system_ext/etc/build.prop", "/odm/etc/build.prop"};
+  const char* dsts[] = {"system.build.prop", "vendor.build.prop", "product.build.prop",
+                        "system_ext.build.prop", "odm.build.prop"};
+  for (size_t i = 0; i < 5; i++) {
+    FILE* in = fopen(srcs[i], "re");
+    if (!in) continue;
+    std::string out = std::string(kOutDir) + "/" + dsts[i];
+    FILE* o = fopen(out.c_str(), "we");
+    if (!o) { fclose(in); continue; }
+    char* line = nullptr; size_t cap = 0; ssize_t n;
+    while ((n = getline(&line, &cap, in)) != -1) {
+      std::string s(line);
+      char* eq = strchr(line, '=');
+      if (eq && line[0] != '#') {
+        std::string key(line, eq - line);
+        auto it = m.find(key);
+        if (it != m.end()) s = key + "=" + it->second + "\n";
+      }
+      fputs(s.c_str(), o);
+    }
+    free(line); fclose(in); fclose(o);
+    LOG("rendered %s", out.c_str());
+  }
+}
+
+int main() {
+  auto ov = load_overrides();
+  if (ov.empty()) { LOG("no overrides loaded, abort"); return 1; }
+
+  if (mkdir(kOutDir, 0755) != 0 && errno != EEXIST) {
+    LOG("mkdir %s: %s", kOutDir, strerror(errno)); return 1;
+  }
+
+  std::string tmp = std::string(kOutDir) + "/props.list.tmp";
+  std::string dst = std::string(kOutDir) + "/props.list";
+  FILE* o = fopen(tmp.c_str(), "we");
+  if (!o) { LOG("open %s: %s", tmp.c_str(), strerror(errno)); return 1; }
+  for (const auto& kv : ov) {
+    // Format: key<TAB>value  (value may be empty; tab keeps parsing simple)
+    fprintf(o, "%s\t%s\n", kv.key.c_str(), kv.val.c_str());
+  }
+  fclose(o);
+  rename(tmp.c_str(), dst.c_str());
+  LOG("wrote %s (%zu keys)", dst.c_str(), ov.size());
+
+  render_build_props(ov);
+  LOG("stage-1 spoof data ready under %s", kOutDir);
+  return 0;
+}
