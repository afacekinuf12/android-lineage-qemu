diff --git a/sepolicy/vendor/spoofprop_gen.te b/sepolicy/vendor/spoofprop_gen.te
new file mode 100644
index 0000000..c7b7115
--- /dev/null
+++ b/sepolicy/vendor/spoofprop_gen.te
@@ -0,0 +1,38 @@
+# spoofprop_gen: builds a spoofed copy of the property area under
+# /dev/__properties_spoof__ and spoofed build.prop files under /dev/spoofprop.
+# Runs at post-fs-data, exits immediately. Enforcing.
+type spoofprop_gen, domain;
+type spoofprop_gen_exec, exec_type, vendor_file_type, file_type;
+type spoofprop_file, file_type;
+
+init_daemon_domain(spoofprop_gen)
+
+# Read the real property area (snapshot) and the policy file.
+r_dir_file(spoofprop_gen, properties_device)
+allow spoofprop_gen system_file:file r_file_perms;
+allow spoofprop_gen system_file:dir r_dir_perms;
+
+# Read the source build.prop files it renders spoofed copies from.
+allow spoofprop_gen system_file:file r_file_perms;
+
+# Create and populate the spoofed copies (own label, NOT properties_device,
+# which keeps clear of the `neverallow {domain -init} properties_device:file`).
+allow spoofprop_gen spoofprop_file:dir { create add_name remove_name write search read open rmdir setattr };
+allow spoofprop_gen spoofprop_file:file { create open read write getattr setattr unlink map rename };
+type_transition spoofprop_gen device:dir spoofprop_file;
+type_transition spoofprop_gen device:file spoofprop_file;
+
+# Private mount namespace + bind mount the copy over /dev/__properties__.
+allow spoofprop_gen self:capability { sys_admin };
+allow spoofprop_gen labeledfs:filesystem { mount unmount };
+allow spoofprop_gen tmpfs:filesystem { mount unmount };
+allow spoofprop_gen spoofprop_file:filesystem { mount unmount associate };
+allow spoofprop_gen properties_device:dir mounton;
+
+# __system_property_add on the (spoof-labeled) area writes memory it mapped;
+# reading serial/area also needs these standard property accesses.
+allow spoofprop_gen properties_serial:file r_file_perms;
+allow spoofprop_gen property_info:file r_file_perms;
+
+# Log to kmsg.
+allow spoofprop_gen kmsg_device:chr_file w_file_perms;
