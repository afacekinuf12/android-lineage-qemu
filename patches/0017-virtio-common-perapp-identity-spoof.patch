diff --git a/services/spoofprop_gen/spoofprop_gen.cpp b/services/spoofprop_gen/spoofprop_gen.cpp
new file mode 100644
index 0000000..b7f277d
--- /dev/null
+++ b/services/spoofprop_gen/spoofprop_gen.cpp
@@ -0,0 +1,178 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * spoofprop_gen (Stage 1) — construct a spoofed, read-only copy of the system
+ * property area plus spoofed build.prop text files, WITHOUT disturbing the real
+ * ones. Stage 2 will bind the result only into target-app mount namespaces.
+ *
+ * Bionic constraints handled here:
+ *   - __system_property_set_filename() is disabled; area init/read use the
+ *     hardcoded /dev/__properties__ path. So we redirect that path with a
+ *     private-namespace bind mount before (re)initialising the area.
+ *   - A read-only reload cannot be written to; a fresh writable area
+ *     (__system_property_area_init) reads <dir>/property_info for SELinux
+ *     contexts and creates empty prop files, which we then populate.
+ *
+ * Sequence:
+ *   1. Snapshot every (name,value) from the real area via __system_property_foreach.
+ *   2. Seed /dev/__properties_spoof__ with a copy of the real property_info tree.
+ *   3. unshare(CLONE_NEWNS)+rprivate, bind the spoof dir over /dev/__properties__.
+ *   4. __system_property_area_init() -> fresh writable area on the spoof dir.
+ *   5. Re-add each snapshotted prop, substituting policy overrides.
+ *   6. Exit: private ns torn down; real area untouched elsewhere; the spoof
+ *      copy persists at /dev/__properties_spoof__ for Stage 2.
+ * Also renders spoofed build.prop files under /dev/spoofprop/ for file reads.
+ *
+ * Fabricates observable identity strings only; does not touch AVB/attestation.
+ */
+
+#define _GNU_SOURCE
+#include <dirent.h>
+#include <fcntl.h>
+#include <sched.h>
+#include <sys/mount.h>
+#include <sys/sendfile.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <algorithm>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <sys/system_properties.h>
+
+#define LOG(...) do { fprintf(stderr, "spoofprop_gen: " __VA_ARGS__); fprintf(stderr, "\n"); } while (0)
+
+static const char* kRealDir   = "/dev/__properties__";
+static const char* kSpoofDir  = "/dev/__properties_spoof__";
+static const char* kPropsFile = "/system/etc/spoof_props.txt";
+static const char* kBuildPropDir = "/dev/spoofprop";
+
+// ---- policy overrides ------------------------------------------------------
+static std::map<std::string, std::string> load_overrides() {
+  std::map<std::string, std::string> m;
+  FILE* f = fopen(kPropsFile, "re");
+  if (!f) { LOG("no %s: %s", kPropsFile, strerror(errno)); return m; }
+  char* line = nullptr; size_t cap = 0; ssize_t n;
+  while ((n = getline(&line, &cap, f)) != -1) {
+    if (n && line[n-1] == n) line[--n] = 0;
+    if (n == 0 || line[0] == #) continue;
+    char* eq = strchr(line, =);
+    if (!eq) continue;
+    *eq = 0;
+    m.emplace(line, eq + 1);
+  }
+  free(line); fclose(f);
+  return m;
+}
+
+// ---- snapshot of the live property area ------------------------------------
+struct Snap { std::vector<std::pair<std::string,std::string>> kv; };
+
+static void read_cb(void* cookie, const char* name, const char* value, uint32_t) {
+  static_cast<Snap*>(cookie)->kv.emplace_back(name, value);
+}
+static void foreach_cb(const prop_info* pi, void* cookie) {
+  __system_property_read_callback(pi, read_cb, cookie);
+}
+
+// ---- copy the serialized property_info context tree ------------------------
+static bool copy_file(const std::string& src, const std::string& dst) {
+  int in = open(src.c_str(), O_RDONLY | O_CLOEXEC);
+  if (in < 0) { LOG("open %s: %s", src.c_str(), strerror(errno)); return false; }
+  int out = open(dst.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (out < 0) { LOG("open %s: %s", dst.c_str(), strerror(errno)); close(in); return false; }
+  struct stat st{}; fstat(in, &st);
+  off_t off = 0; ssize_t rem = st.st_size; bool ok = true;
+  while (rem > 0) { ssize_t k = sendfile(out, in, &off, rem); if (k <= 0) { ok = (k==0); break; } rem -= k; }
+  close(in); close(out); return ok;
+}
+
+static void render_build_props(const std::map<std::string,std::string>& ov) {
+  const char* srcs[] = { "/system/build.prop","/vendor/build.prop","/product/etc/build.prop",
+                         "/system_ext/etc/build.prop","/odm/etc/build.prop" };
+  const char* dsts[] = { "system.build.prop","vendor.build.prop","product.build.prop",
+                         "system_ext.build.prop","odm.build.prop" };
+  mkdir(kBuildPropDir, 0755);
+  for (size_t i = 0; i < 5; i++) {
+    FILE* in = fopen(srcs[i], "re"); if (!in) continue;
+    std::string out = std::string(kBuildPropDir) + "/" + dsts[i];
+    FILE* o = fopen(out.c_str(), "we"); if (!o) { fclose(in); continue; }
+    char* line = nullptr; size_t cap = 0; ssize_t n;
+    while ((n = getline(&line, &cap, in)) != -1) {
+      std::string s(line);
+      char* eq = strchr(line, =);
+      if (eq && line[0] != #) {
+        std::string key(line, eq - line);
+        auto it = ov.find(key);
+        if (it != ov.end()) s = key + "=" + it->second + "\n";
+      }
+      fputs(s.c_str(), o);
+    }
+    free(line); fclose(in); fclose(o);
+    LOG("rendered %s", out.c_str());
+  }
+}
+
+int main() {
+  auto ov = load_overrides();
+
+  // 1. Snapshot the real area (still mapped read-only by libc init).
+  Snap snap;
+  __system_property_foreach(foreach_cb, &snap);
+  LOG("snapshot %zu props", snap.kv.size());
+  if (snap.kv.empty()) { LOG("empty snapshot, abort"); return 1; }
+
+  // 2. Seed spoof dir with the real SELinux context tree.
+  mkdir(kSpoofDir, 0711);
+  std::string real_info = std::string(kRealDir) + "/property_info";
+  std::string spoof_info = std::string(kSpoofDir) + "/property_info";
+  if (!copy_file(real_info, spoof_info)) { LOG("copy property_info failed"); return 1; }
+
+  render_build_props(ov);
+
+  // 3. Private ns + bind spoof over the hardcoded path.
+  if (unshare(CLONE_NEWNS) != 0) { LOG("unshare: %s", strerror(errno)); return 1; }
+  if (mount(nullptr, "/", nullptr, MS_REC | MS_PRIVATE, nullptr) != 0) {
+    LOG("rprivate: %s", strerror(errno)); return 1;
+  }
+  if (mount(kSpoofDir, kRealDir, nullptr, MS_BIND | MS_REC, nullptr) != 0) {
+    LOG("bind: %s", strerror(errno)); return 1;
+  }
+
+  // 4. Fresh writable area on the spoof dir (reads copied property_info).
+  bool xattr_fail = false;
+  // Returns -1 when the fsetxattr to a property_type context is SELinux-denied
+  // (expected: our copy is labeled spoofprop_file, not property_type). The area
+  // is still created and usable, so proceed regardless.
+  (void)__system_property_area_init();
+  (void)xattr_fail;
+
+  // 5. Re-add every prop, substituting overrides.
+  size_t added = 0, over = 0;
+  for (auto& [k, v] : snap.kv) {
+    const std::string* val = &v;
+    auto it = ov.find(k);
+    if (it != ov.end()) { val = &it->second; over++; }
+    if (val->size() >= PROP_VALUE_MAX) { LOG("skip oversize %s", k.c_str()); continue; }
+    if (__system_property_add(k.c_str(), (unsigned)k.size(), val->c_str(), (unsigned)val->size()) != 0)
+      LOG("add failed %s", k.c_str());
+    else added++;
+  }
+  // Overrides that did not exist in the real area (e.g. cleared lineage props
+  // are simply omitted; genuinely-new keys get added here).
+  for (auto& [k, v] : ov) {
+    if (std::none_of(snap.kv.begin(), snap.kv.end(),
+                     [&](auto& p){ return p.first == k; })) {
+      if (v.empty() || v.size() >= PROP_VALUE_MAX) continue;
+      if (__system_property_add(k.c_str(), (unsigned)k.size(), v.c_str(), (unsigned)v.size()) == 0) added++;
+    }
+  }
+  LOG("rebuilt spoof area: %zu props, %zu overridden -> %s", added, over, kSpoofDir);
+  return 0;
+}
