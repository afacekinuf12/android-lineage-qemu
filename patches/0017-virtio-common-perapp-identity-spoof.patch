diff --git a/device-common.mk b/device-common.mk
index 892789d..8eec280 100644
--- a/device-common.mk
+++ b/device-common.mk
@@ -77,3 +77,13 @@ PRODUCT_PACKAGES += \
     fstab.virtio.gsi.sda.vendor_ramdisk \
     fstab.virtio.gsi.vdc.vendor_ramdisk \
     fstab.caiman.vendor_ramdisk
+
+# Identity spoof (Stage 1): generator + policy files. The generator emits
+# spoofed data under /dev/spoofprop at boot; Stage 2 will expose it only to
+# target-app namespaces. No effect on system processes.
+PRODUCT_PACKAGES += \
+    spoofprop_gen
+
+PRODUCT_COPY_FILES += \
+    $(COMMON_PATH)/configs/spoof/spoof_props.txt:$(TARGET_COPY_OUT_SYSTEM)/etc/spoof_props.txt \
+    $(COMMON_PATH)/configs/spoof/spoof_policy.json:$(TARGET_COPY_OUT_SYSTEM)/etc/spoof_policy.json
