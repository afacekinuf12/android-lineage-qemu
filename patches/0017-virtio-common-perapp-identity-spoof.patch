diff --git a/sepolicy/vendor/spoofprop_gen.te b/sepolicy/vendor/spoofprop_gen.te
new file mode 100644
index 0000000..b78bf29
--- /dev/null
+++ b/sepolicy/vendor/spoofprop_gen.te
@@ -0,0 +1,21 @@
+# spoofprop_gen (Stage 1): renders spoofed build.prop copies and a flat
+# props.list under /dev/spoofprop from /system/etc/spoof_props.txt. Performs NO
+# mounts, NO property-area access, NO property-area writes. Enforcing.
+type spoofprop_gen, domain;
+type spoofprop_gen_exec, exec_type, vendor_file_type, file_type;
+type spoofprop_file, file_type;
+
+init_daemon_domain(spoofprop_gen)
+
+# Read the policy file and the source build.prop files (system_file-labeled).
+allow spoofprop_gen system_file:dir r_dir_perms;
+allow spoofprop_gen system_file:file r_file_perms;
+
+# Create and populate the spoofed output under /dev (own spoofprop_file label).
+allow spoofprop_gen device:dir { search write add_name remove_name };
+type_transition spoofprop_gen device:dir spoofprop_file "spoofprop";
+allow spoofprop_gen spoofprop_file:dir { create search read write open add_name remove_name setattr getattr };
+allow spoofprop_gen spoofprop_file:file { create open read write getattr setattr unlink rename };
+
+# Log to kmsg (stdio_to_kmsg).
+allow spoofprop_gen kmsg_device:chr_file w_file_perms;
